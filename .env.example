# Copia questo file in .env.local e compila i valori. .env.local NON si committa.

# ── Chatbot AI (già in uso) ───────────────────────────────────────────
GEMINI_API_KEY=

# ── Invio dei moduli via email (Resend) ───────────────────────────────
# Senza RESEND_API_KEY i moduli NON inviano nulla: mostrano un messaggio onesto con un pulsante "email già compilata"
# (mailto verso info@aletheiasrl.it) e il telefono, e lo annotano nei log del server. Vedi MIGRAZIONE.md, "Checklist lancio moduli".
# Chiave API di Resend (dashboard Resend → API Keys, permesso "Sending access"). Inserirla SOLO nelle variabili di Vercel / .env.local.
RESEND_API_KEY=
# Mittente: deve appartenere al dominio verificato su Resend. Es. "Alètheia Srl <sito@aletheiasrl.it>"
MAIL_FROM=
# Destinatario delle richieste (anche più indirizzi separati da virgola). Se vuota: info@aletheiasrl.it
MAIL_TO=
# SOLO PER I TEST: indirizzo di un Resend finto. Viene ignorata quando NODE_ENV=production; non impostarla su Vercel.
# RESEND_API_URL=

# ── Backend headless WordPress (plugin wordpress/aletheia-headless) ───
# Lascia WP_URL VUOTO finché WordPress non esiste: il sito usa i dati locali
# (data/*, lib/newsData.js) e funziona identico a prima. Quando il CMS è online
# basta impostarlo, senza modifiche al codice.
#
# URL base di WordPress, senza slash finale. Es. https://cms.aletheiasrl.it
WP_URL=
# Stringa casuale lunga, IDENTICA a ALETHEIA_SHARED_SECRET in wp-config.php.
# Firma i link di anteprima e autentica il webhook /api/revalidate.
# Generala con:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WP_SHARED_SECRET=

# (Facoltativa) Origine di WordPress accettata per l'anteprima live nell'editor. Se vuota si usa l'origine di WP_URL.
# Impostala solo se l'admin di WordPress sta su un host diverso da quello delle API.
NEXT_PUBLIC_WP_ORIGIN=
